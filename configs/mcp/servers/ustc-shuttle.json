{
  "schema_version": 1,
  "server_id": "ustc-shuttle",
  "enabled": true,
  "transport": "stdio",
  "protocol_mode": "legacy",
  "endpoint": {
    "command": "/usr/local/bin/python",
    "args": [
      "/AstrBot/data/ustc-campus-mcp/run_ustc_mcp.py",
      "--service",
      "shuttle"
    ],
    "cwd": "/AstrBot/data/ustc-campus-mcp",
    "env_allowlist": [
      "LANG",
      "LC_ALL",
      "PATH",
      "PYTHONPATH",
      "USTC_SHUTTLE_URL"
    ]
  },
  "secret_refs": [],
  "allowed_tools": [
    "shuttle_current_schedule",
    "shuttle_search_trips"
  ],
  "denied_tools": [],
  "timeouts_seconds": {
    "connect": 10,
    "discovery": 10,
    "call": 30,
    "maximum_call": 60,
    "close": 5
  },
  "retry": {
    "maximum_attempts": 2,
    "base_delay_ms": 100
  },
  "circuit": {
    "failure_threshold": 3,
    "failure_window_seconds": 60,
    "open_duration_seconds": 30
  },
  "maximum_concurrency": 2,
  "schema_ttl_seconds": 300,
  "config_revision": "ustc-shuttle-read-v1"
}
