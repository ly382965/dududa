{
  "schema_version": 1,
  "server_id": "training-plan",
  "enabled": false,
  "transport": "stdio",
  "protocol_mode": "legacy",
  "endpoint": {
    "command": "/usr/local/bin/python",
    "args": [
      "/AstrBot/data/training-plan-mcp/run_training_plan_mcp.py",
      "--db-path",
      "/AstrBot/data/training-plan-cache/plans.sqlite3"
    ],
    "cwd": "/AstrBot/data/training-plan-mcp",
    "env_allowlist": ["LANG", "LC_ALL", "PATH", "PYTHONPATH"]
  },
  "secret_refs": [],
  "allowed_tools": ["training_programs_public_query"],
  "denied_tools": ["check_robots", "refresh_programs"],
  "timeouts_seconds": {
    "connect": 10,
    "discovery": 10,
    "call": 15,
    "maximum_call": 30,
    "close": 5
  },
  "retry": {"maximum_attempts": 1, "base_delay_ms": 100},
  "circuit": {
    "failure_threshold": 3,
    "failure_window_seconds": 60,
    "open_duration_seconds": 30
  },
  "maximum_concurrency": 2,
  "schema_ttl_seconds": 300,
  "config_revision": "training-plan-cache-read-v1"
}
