{
  "schema_version": 1,
  "server_id": "icourse",
  "enabled": true,
  "transport": "stdio",
  "protocol_mode": "legacy",
  "endpoint": {
    "command": "/usr/local/bin/python",
    "args": [
      "/AstrBot/data/icourse-mcp/run_icourse_mcp.py",
      "--db-path",
      "/AstrBot/data/icourse-cache/icourse.sqlite3",
      "--request-delay",
      "1.0"
    ],
    "cwd": "/AstrBot/data/icourse-mcp",
    "env_allowlist": [
      "LANG",
      "LC_ALL",
      "PATH",
      "PYTHONPATH"
    ]
  },
  "secret_refs": [],
  "allowed_tools": [
    "crawl_course",
    "get_course",
    "get_reviews",
    "icourse_stats",
    "search_courses",
    "search_site_courses"
  ],
  "denied_tools": [
    "check_robots",
    "crawl_courses",
    "crawl_latest_reviews",
    "export_dataset"
  ],
  "timeouts_seconds": {
    "connect": 10,
    "discovery": 10,
    "call": 30,
    "maximum_call": 120,
    "close": 5
  },
  "retry": {
    "maximum_attempts": 2,
    "base_delay_ms": 100
  },
  "circuit": {
    "failure_threshold": 3,
    "failure_window_seconds": 60,
    "open_duration_seconds": 30
  },
  "maximum_concurrency": 1,
  "schema_ttl_seconds": 300,
  "config_revision": "icourse-transport-v1"
}
