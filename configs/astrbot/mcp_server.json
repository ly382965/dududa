{
  "mcpServers": {
    "icourse": {
      "command": "/usr/local/bin/python",
      "args": [
        "/AstrBot/data/icourse-mcp/run_icourse_mcp.py",
        "--db-path",
        "/AstrBot/data/icourse-cache/icourse.sqlite3",
        "--request-delay",
        "1.0"
      ],
      "disabled": true
    },
    "ustc-academic": {
      "command": "/usr/local/bin/python",
      "args": [
        "/AstrBot/data/ustc-campus-mcp/run_ustc_mcp.py",
        "--service",
        "academic"
      ],
      "disabled": true
    },
    "ustc-curriculum": {
      "command": "/usr/local/bin/python",
      "args": [
        "/AstrBot/data/ustc-campus-mcp/run_ustc_mcp.py",
        "--service",
        "curriculum"
      ],
      "disabled": true
    },
    "ustc-young": {
      "command": "/usr/local/bin/python",
      "args": [
        "/AstrBot/data/ustc-campus-mcp/run_ustc_mcp.py",
        "--service",
        "young"
      ],
      "disabled": true
    }
  }
}
