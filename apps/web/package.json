{
  "name": "@dududa/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=10.9.3"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "concurrently -k -n api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist-server/index.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node dist-server/index.cjs",
    "test": "vitest run && vitest run --config vitest.server.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@tanstack/vue-virtual": "^3.13.35",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-document": "^3.29.2",
    "@tiptap/extension-hard-break": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-paragraph": "^3.29.2",
    "@tiptap/extension-text": "^3.29.2",
    "@tiptap/extensions": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "@vueuse/core": "14.3.0",
    "busboy": "^1.6.0",
    "dexie": "^4.4.4",
    "lottie-web": "^5.13.0",
    "markdown-it": "^15.0.0",
    "pinia": "^4.0.2",
    "pinyin-match": "^1.2.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/busboy": "^1.5.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
