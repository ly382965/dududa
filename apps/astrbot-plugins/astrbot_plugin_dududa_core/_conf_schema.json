{
  "enabled": {
    "description": "启用插件",
    "type": "bool",
    "default": true
  },
  "runtime_enabled": {
    "description": "启用 Dududa 生产 Runtime 装配",
    "type": "bool",
    "default": false
  },
  "runtime_models_json": {
    "description": "生产 Runtime 模型端点配置 JSON 数组",
    "type": "text",
    "default": "[]"
  },
  "runtime_provider_evidence_path": {
    "description": "仓库外 AstrBot Provider Conformance Evidence JSON 路径",
    "type": "string",
    "default": "",
    "hint": "仅保存验证结论和模型绑定，不包含 API Key、Base URL、QQ 标识或聊天正文。"
  },
  "runtime_health_probe_enabled": {
    "description": "启用生产 Runtime 模型健康主动刷新",
    "type": "bool",
    "default": false
  },
  "runtime_health_probe_interval_seconds": {
    "description": "模型健康刷新间隔（秒）",
    "type": "int",
    "default": 900
  },
  "runtime_health_probe_timeout_seconds": {
    "description": "单次模型健康探测超时（秒）",
    "type": "int",
    "default": 15
  },
  "runtime_health_evidence_ttl_seconds": {
    "description": "模型健康证据有效期（秒）",
    "type": "int",
    "default": 1800
  },
  "runtime_response_profiles_enabled": {
    "description": "启用短、中、长回答档位",
    "type": "bool",
    "default": true
  },
  "rollout_mode": {
    "description": "新 Runtime 上线模式（off/shadow/canary）",
    "type": "string",
    "default": "off",
    "hint": "仅接受 off、shadow、canary；非法值会关闭新 Runtime。"
  },
  "rollout_revision": {
    "description": "上线控制配置版本",
    "type": "string",
    "default": "rollout-off-v1",
    "hint": "每次修改白名单、模式或熔断状态时使用新的稳定版本号。"
  },
  "rollout_delivery_enabled": {
    "description": "允许 Canary 实际发送",
    "type": "bool",
    "default": false
  },
  "rollout_allowlisted_groups": {
    "description": "新 Runtime 允许处理的群号",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "hint": "填写 * 表示所有群；仍只接管明确 @Bot 的受支持文本，未 @ 消息交给群聊插件与后续主动参与策略。"
  },
  "rollout_kill_switch": {
    "description": "新 Runtime 紧急熔断",
    "type": "bool",
    "default": true,
    "hint": "开启时不接受新任务；已取得所有权的任务也会在发送前再次检查。"
  },
  "rollout_tools_enabled": {
    "description": "新 Runtime 工具能力",
    "type": "bool",
    "default": false,
    "hint": "S11 必须保持关闭。"
  },
  "rollout_memory_enabled": {
    "description": "新 Runtime Memory 能力",
    "type": "bool",
    "default": false,
    "hint": "S11 必须保持关闭。"
  },
  "rollout_maximum_text_bytes": {
    "description": "新 Runtime 单条文本最大 UTF-8 字节数",
    "type": "int",
    "default": 8192
  },
  "rollout_shadow_max_in_flight": {
    "description": "Shadow 最大后台并发数",
    "type": "int",
    "default": 2
  },
  "rollout_shadow_timeout_ms": {
    "description": "Shadow 单任务超时（毫秒）",
    "type": "int",
    "default": 30000
  },
  "rollout_canary_timeout_ms": {
    "description": "Canary 单任务超时（毫秒）",
    "type": "int",
    "default": 60000
  },
  "owners": {
    "description": "全局 owner QQ 号",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": [],
    "hint": "留空时会回退使用 AstrBot 全局 admins_id。"
  },
  "global_admins": {
    "description": "全局 admin QQ 号",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": []
  },
  "trusted_users": {
    "description": "可信用户 QQ 号",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": []
  },
  "muted_users": {
    "description": "禁用用户 QQ 号",
    "type": "list",
    "items": {
      "type": "string"
    },
    "default": []
  },
  "group_admins": {
    "description": "群级管理员 JSON，格式为 {\"群号\": [\"QQ号\"]}",
    "type": "text",
    "default": "{}"
  },
  "course_refresh_cooldown_seconds": {
    "description": "课程刷新冷却秒数",
    "type": "int",
    "default": 600
  },
  "default_model_id": {
    "description": "默认聊天模型 ID",
    "type": "string",
    "default": "openai/gpt-5.5"
  },
  "image_model_id": {
    "description": "图像生成模型 ID",
    "type": "string",
    "default": "gpt-image-2",
    "hint": "当前标记为可用但较慢，默认谨慎调用。"
  },
  "image_timeout_seconds": {
    "description": "图像生成等待超时秒数",
    "type": "int",
    "default": 420,
    "hint": "gpt-image-2 可能较慢；运行时会限制在 60-900 秒之间。"
  }
}
