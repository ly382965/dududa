COMPOSE_PROJECT_NAME=dududa
TZ=Asia/Shanghai

STACK_DATA_ROOT=./data
DUDUDA_WEB_DATA_ROOT=./runtime/web
# Writable API Key pool directory. This relative example resolves to a sibling
# of the checkout; production should normally use an absolute persistent path.
# ops/manage.sh rejects paths inside the repository. The Web container keeps
# the JSON file at /var/lib/dududa/api-keys/api-keys.json with mode 0600.
DUDUDA_API_KEY_STORE_ROOT=../dududa-state/api-keys
# Shared scoped Agent policy: Web writes as UID 1000; AstrBot mounts read-only.
DUDUDA_AGENT_POLICY_ROOT=../dududa-state/agent
DUDUDA_MCP_RUNTIME_ROOT=./runtime/mcp
EDGE_NETWORK=mmdustc-edge

ASTRBOT_BASE_IMAGE=soulter/astrbot:v4.27.5@sha256:1db1792902be5ccecfb907a720ae22b233ebdc958854d860fc73d7f95a720637
DUDUDA_ASTRBOT_IMAGE=dududa/astrbot:local
DUDUDA_WEB_IMAGE=dududa/web:local
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.19@sha256:1336a777f9a4f1f8cb89fef42f7548deacd3645919a067a50df5b66b5e77390e

NAPCAT_UID=1000
NAPCAT_GID=1000

ASTRBOT_WEBUI_HOST=127.0.0.1
ASTRBOT_WEBUI_PORT=6185

NAPCAT_WEBUI_HOST=127.0.0.1
NAPCAT_WEBUI_PORT=6099

DUDUDA_WEB_HOST=127.0.0.1
DUDUDA_WEB_PORT=5173

HF_ENDPOINT=https://hf-mirror.com

# Optional HTTP(S) proxy for Emoji Kitchen metadata/images inside the AstrBot container.
# On Linux Docker, a host proxy may be reachable through the bot network gateway,
# for example: http://172.19.0.1:7890
DUDUDA_EMOJI_KITCHEN_HTTP_PROXY=

# Optional Sub2API read-only dashboard integration. Keep credentials only in
# your private .env or AstrBot plugin configuration; never commit real values.
SUB2API_BASE_URL=
SUB2API_ADMIN_EMAIL=
SUB2API_ADMIN_PASSWORD=
